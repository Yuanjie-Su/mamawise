<!--pages/chat/chat.wxml-->
<view class="container chat-container" bindtap="closeModelSelector">
  <view class="chat-header">
    <view class="model-display">
      <text class="model-name">{{currentModelName}}</text>
      <view class="dropdown-icon" catchtap="toggleModelSelector">▼</view>
    </view>
    <view class="header-actions">
      <view class="clear-btn" catchtap="clearChat">清空</view>
    </view>
  </view>
  
  <!-- 模型选择器下拉菜单 -->
  <view class="model-dropdown" wx:if="{{showModelSelector}}" catchtap="stopPropagation">
    <view class="model-option {{item.id === currentModel ? 'selected' : ''}}" 
          wx:for="{{modelOptions}}" 
          wx:key="id" 
          catchtap="selectModel" 
          data-model="{{item.id}}">
      {{item.name}}
    </view>
  </view>
  
  <scroll-view 
    scroll-y="true" 
    class="message-list" 
    scroll-top="{{scrollTop}}"
    id="message-container"
    enhanced="true"
    show-scrollbar="false"
    scroll-anchoring="true">
    
    <!-- 推荐问题区域，仅在没有消息时显示 -->
    <view class="recommended-questions" wx:if="{{messages.length === 0}}">
      <view 
        class="recommended-question" 
        wx:for="{{recommendedQuestions}}" 
        wx:key="*this" 
        bindtap="onRecommendedQuestion" 
        data-question="{{item}}">
        {{item}}
      </view>
    </view>
    
    <block wx:for="{{messages}}" wx:key="id">
      <!-- 系统消息（AI回复）或用户消息 -->
      <view class="message-item {{item.type === 'system' ? 'system-message' : 'user-message'}}">
        <view class="message-content {{item.type === 'system' ? 'system-content' : 'user-content'}}">
          <text class="message-text">{{item.content}}</text>
        </view>
      </view>
    </block>
    
    <!-- 加载中提示 -->
    <view class="loading-container" wx:if="{{isLoading}}">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </scroll-view>
  
  <view class="input-area">
    <view class="input-container">
      <input 
        class="message-input" 
        value="{{inputValue}}" 
        bindinput="onInputChange"
        placeholder="请输入您的问题..." 
        confirm-type="send"
        bindconfirm="sendMessage"
        adjust-position="true"
        cursor-spacing="20"
      />
      <view class="send-btn" bindtap="sendMessage">
        <image class="send-icon" src="/images/send.png"></image>
      </view>
    </view>
  </view>
</view> 