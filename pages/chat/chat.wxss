/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  background-color: #F8F8F8;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.header-actions {
  display: flex;
  align-items: center;
}

.records-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  margin-right: 20rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: var(--text-light);
}

.message-list {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

/* 推荐问题样式 */
.recommended-questions {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  margin-bottom: 20rpx;
}

.recommended-title {
  font-size: 30rpx;
  color: var(--text-light);
  margin-bottom: 30rpx;
}

.recommended-question {
  background-color: #FFFFFF;
  color: var(--primary-color);
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  width: 90%;
  text-align: center;
  font-size: 28rpx;
  border: 1rpx solid var(--primary-light);
}

.message-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  position: relative;
  max-width: 85%;
}

.system-message {
  align-self: flex-start;
}

.user-message {
  align-self: flex-end;
}

.avatar-container {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
}

.message-content {
  padding: 20rpx;
  border-radius: 10rpx;
  word-wrap: break-word;
  width: 100%;
}

.system-content {
  background-color: #FFFFFF;
  color: var(--text-color);
  border-top-left-radius: 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.user-content {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border-top-right-radius: 0;
}

.loading-container {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 30rpx;
  padding-left: 60rpx;
}

.loading-dots {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  margin: 0 6rpx;
  animation: dot-flashing 1s infinite alternate;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-flashing {
  0% {
    opacity: 0.2;
  }
  100% {
    opacity: 1;
  }
}

.input-area {
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid var(--border-color);
}

.input-container {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #CCCCCC;
}

.send-btn.active {
  background-color: var(--primary-color);
  color: #FFFFFF;
} 