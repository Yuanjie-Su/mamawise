/* pages/profile/profile.wxss */
.profile-container {
  background-color: #F8F8F8;
  min-height: 100vh;
}

.user-card {
  background-color: var(--primary-light);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  background-color: #FFFFFF;
}

.user-details {
  margin-left: 30rpx;
}

.username {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.user-desc {
  font-size: 26rpx;
  color: var(--text-light);
}

.login-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  background-color: var(--primary-color);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  line-height: 1.5;
  min-height: auto;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background-color: #FFFFFF;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.action-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.menu-list {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-container {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
}

.arrow {
  color: var(--text-light);
  font-size: 30rpx;
}

.about-section {
  background-color: #FFFFFF;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.version-info {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 30rpx;
}

/* 开发者工具面板样式 */
.dev-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
}

.dev-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.dev-panel-title {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
}

.dev-panel-actions {
  display: flex;
}

.dev-action-btn {
  color: #FFFFFF;
  font-size: 28rpx;
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #FFFFFF;
  border-radius: 30rpx;
}

.close-btn {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
}

.dev-tabs {
  display: flex;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  overflow: hidden;
}

.dev-tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  color: #FFFFFF;
  font-size: 28rpx;
}

.dev-tab-item.active {
  background-color: var(--primary-color);
  font-weight: bold;
}

.dev-tab-content {
  flex: 1;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 10rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.log-actions {
  display: flex;
  margin-bottom: 20rpx;
}

.log-action-btn {
  background-color: var(--primary-color);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.log-filter {
  display: flex;
  margin-bottom: 20rpx;
  background-color: #F5F5F5;
  border-radius: 10rpx;
  overflow: hidden;
}

.log-filter-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--text-color);
}

.log-filter-item.active {
  background-color: var(--primary-color);
  color: #FFFFFF;
  font-weight: bold;
}

.log-list {
  flex: 1;
  overflow-y: auto;
}

.empty-logs {
  text-align: center;
  color: var(--text-light);
  padding: 50rpx 0;
  font-size: 30rpx;
}

.log-item {
  margin-bottom: 20rpx;
  padding: 15rpx;
  border-radius: 8rpx;
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.log-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.log-level {
  font-weight: bold;
  font-size: 26rpx;
}

.log-time {
  font-size: 24rpx;
  color: var(--text-light);
}

.log-message {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.log-data {
  font-size: 24rpx;
  color: var(--text-light);
  background-color: #F5F5F5;
  padding: 10rpx;
  border-radius: 6rpx;
  word-break: break-all;
}

/* 不同级别日志的样式 */
.log-level-DEBUG .log-level {
  color: #7BBFE5;
}

.log-level-INFO .log-level {
  color: #4CAF50;
}

.log-level-WARN .log-level {
  color: #FF9800;
}

.log-level-ERROR .log-level {
  color: #F44336;
}

/* 调试信息样式 */
.debug-info {
  flex: 1;
  overflow-y: auto;
}

.debug-section {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.debug-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 15rpx;
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: 10rpx;
}

.debug-item {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.debug-item:last-child {
  border-bottom: none;
}

.debug-label {
  width: 200rpx;
  color: var(--text-light);
  font-size: 26rpx;
}

.debug-value {
  flex: 1;
  font-size: 26rpx;
}