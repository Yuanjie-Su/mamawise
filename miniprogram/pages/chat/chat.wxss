/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  background-color: #F8F8F8;
  position: relative;
  overflow: hidden;
  /* 防止内容溢出 */
}

.chat-header {
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.header-actions {
  display: flex;
  align-items: center;
}

.records-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  margin-right: 20rpx;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #999999;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

.placeholder {
  width: 80rpx;
  /* 与clear-btn按钮宽度一致 */
  height: 40rpx;
  /* 与clear-btn按钮高度一致 */
}

.message-list {
  display: flex;
  flex-direction: column;
  padding: 20rpx 30rpx;
  overflow-y: auto;
  flex: 1;
  padding-bottom: 160rpx;
  /* 增加底部padding，为悬浮按钮留出空间 */
  height: calc(100vh - 180rpx);
  /* 减去头部和输入框的高度 */
  box-sizing: border-box;
}

/* 推荐问题样式 */
.recommended-questions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recommended-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 30rpx;
  font-weight: 500;
}

.recommended-question {
  background-color: rgba(var(--primary-color-rgb), 0.08);
  color: var(--primary-color);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  max-width: 90%;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.recommended-question:active {
  transform: scale(0.98);
  background-color: rgba(var(--primary-color-rgb), 0.12);
}

.message-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 10rpx;
  transition: opacity 0.2s;
  position: relative;
  max-width: 100%;
}

.message-item:active {
  opacity: 0.7;
}

.system-message {
  align-self: flex-start;
  align-items: flex-start;
  margin-top: 0rpx;
}

.user-message {
  align-self: flex-end;
  align-items: flex-end;
}

.message-content {
  padding: 16rpx 16rpx;
  border-radius: 10rpx;
  word-wrap: break-word;
  width: fit-content;
  max-width: 100%;
}

.system-content {
  background-color: #FFFFFF;
  color: var(--text-color);
  border-top-left-radius: 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  text-align: left;
  align-self: flex-start;
}

.user-content {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border-top-right-radius: 0;
  text-align: left;
  align-self: flex-end;
}

.loading-container {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 20rpx;
  /* 减少底部间距 */
  margin-top: 4rpx;
  /* 添加顶部间距 */
  padding-left: 60rpx;
}

.loading-dots {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  margin: 0 6rpx;
  animation: dot-flashing 1s infinite alternate;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dot-flashing {
  0% {
    opacity: 0.2;
  }

  100% {
    opacity: 1;
  }
}

.input-area {
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid var(--border-color);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.input-container {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.erase-btn,
.send-btn {
  width: 60rpx;
  /* 调整宽度 */
  height: 60rpx;
  /* 调整高度 */
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 20rpx;
  /* 圆形按钮 */
  background-color: transparent;
  /* 默认背景透明 */
}

.erase-icon {
  width: 40rpx;
  /* 图标宽度 */
  height: 40rpx;
  /* 图标高度 */
}

.send-icon {
  width: 48rpx;
  /* 图标宽度 */
  height: 48rpx;
  /* 图标高度 */
}

.fallback-text {
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 28rpx;
  line-height: 1.5;
}

.message-text {
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 28rpx;
  line-height: 1.4;
  /* 减少行高 */
  margin: 0;
  /* 确保没有额外的margin */
  padding: 0;
  /* 确保没有额外的padding */
}

/* 消息操作按钮样式 */
.message-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  margin-top: 8rpx;
}

.action-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  padding: 8rpx;
  border-radius: 8rpx;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.copy-btn,
.share-btn,
.note-btn,
.save-image-btn {
  background-color: #ffffff;
}

.copy-btn:active,
.share-btn:active,
.note-btn:active,
.save-image-btn:active {
  background-color: #ffffff;
}

/* 确保消息列表内容正确填充 */
.message-list-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

/* 悬浮清除按钮样式 */
.floating-clear-btn {
  position: fixed;
  right: 30rpx;
  bottom: 140rpx;
  /* 位于输入框上方 */
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  transition: all 0.3s ease;
}

.floating-clear-btn:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 底部推荐问题样式 */
.bottom-questions {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: center;
}

.bottom-questions .recommended-question {
  display: inline-block;
  margin: 10rpx;
  font-size: 26rpx;
  padding: 16rpx 30rpx;
  max-width: none;
}

/* 长按消息操作菜单 */
.message-action-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
}

.menu-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.menu-content {
  width: 440rpx;
  max-width: 90%;
  background-color: #313131;
  border-radius: 20rpx;
  position: absolute;
  z-index: 1001;
  overflow: visible;
  animation: pop-in 0.2s ease;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.2);
  left: 50%;
  transform: translate(-50%, -50%);
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }

  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.menu-title {
  display: none;
}

.menu-options {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx;
}

.menu-option {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.menu-arrow {
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #313131;
}

.delete-option .menu-text {
  color: #FFFFFF;
}

.menu-cancel {
  display: none;
}

.menu-cancel:active {
  background-color: #F5F5F5;
}

/* 欢迎页面样式 */
.welcome-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.app-logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 40rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.welcome-text {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 20rpx;
}

.welcome-subtext {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 30rpx;
  line-height: 1.5;
}