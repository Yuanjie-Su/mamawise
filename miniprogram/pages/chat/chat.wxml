<!--pages/chat/chat.wxml-->
<view class="container chat-container" bindtap="closeModelSelector">
  <!-- 隐藏的canvas用于生成分享图片 -->
  <canvas canvas-id="shareCanvas" style="position: absolute; left: -9999px; width: 750px; height: {{canvasHeight}}px;"></canvas>
  
  <view class="chat-header">
    <view class="model-display">
      <button class="model-button" catchtap="toggleModelSelector">
        <text class="model-name">{{currentModelName}}</text>
        <view class="dropdown-icon">▼</view>
      </button>
    </view>
    <view class="header-actions">
      <view class="placeholder"></view>
    </view>
  </view>
  
  <!-- 模型选择器下拉菜单 -->
  <view class="model-dropdown" wx:if="{{showModelSelector}}" catchtap="stopPropagation">
    <view class="dropdown-triangle"></view>
    <view class="model-option {{item.name === currentModelName ? 'selected' : ''}}" 
          wx:for="{{modelOptions}}" 
          wx:key="name" 
          catchtap="selectModel" 
          data-model="{{item.name}}">
      <view class="model-option-name">{{item.name}}</view>
      <view class="model-option-desc">{{item.description}}</view>
    </view>
  </view>
  
  <scroll-view 
    scroll-y="true" 
    class="message-list" 
    scroll-top="{{scrollTop}}"
    id="message-container"
    enhanced="true"
    show-scrollbar="false"
    scroll-anchoring="true"
    bounces="{{false}}"
    enable-flex="true">
    
    <view class="message-list-content">
      <!-- 推荐问题区域，仅在没有消息时显示 -->
      <view class="recommended-questions" wx:if="{{messages.length === 0}}">
        <view 
          class="recommended-question" 
          wx:for="{{recommendedQuestions}}" 
          wx:for-item="question"
          wx:key="*this" 
          bindtap="onRecommendedQuestion" 
          data-question="{{question}}">
          {{question}}
        </view>
      </view>
      
      <block wx:for="{{messages}}" wx:key="id">
        <!-- 用户消息始终显示 -->
        <view class="message-item user-message" wx:if="{{item.type === 'user'}}">
          <view class="message-content user-content">
            <text class="message-text">{{item.content}}</text>
          </view>
        </view>
        
        <!-- 系统消息（AI回复）只有当有内容时才显示 -->
        <view class="message-item system-message" wx:if="{{item.type === 'system'}}">
          <view class="message-content system-content">
            <text class="message-text" user-select="true">{{item.content}}</text>
            
            <!-- 只在AI回复消息中显示操作按钮，且不是正在加载的消息 -->
            <view class="message-actions" wx:if="{{item.id !== loadingMessageId}}">
              <view class="action-btn copy-btn" catchtap="copyMessage" data-content="{{item.content}}">
                <image class="action-icon" src="/images/icons/copy.png" mode="aspectFit"></image>
              </view>
              <view class="action-btn share-btn" catchtap="shareMessage" data-content="{{item.content}}" data-index="{{index}}">
                <image class="action-icon" src="/images/icons/share.png" mode="aspectFit"></image>
              </view>
              <view class="action-btn favorite-btn {{item.isFavorited ? 'disabled' : ''}}" catchtap="{{item.isFavorited ? '' : 'toggleFavorite'}}" data-content="{{item.content}}" data-id="{{item.id}}">
                <image class="action-icon" src="{{item.isFavorited ? '/images/icons/favorited.png' : '/images/icons/favorite.png'}}" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </view>
      </block>
      
      <!-- 加载中提示 -->
      <view class="loading-container" wx:if="{{isLoading}}">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
      
      <!-- 推荐问题区域，只要有消息且不在加载中就显示 -->
      <view class="recommended-questions bottom-questions" wx:if="{{messages.length > 0 && !isLoading}}">
        <view 
          class="recommended-question" 
          wx:for="{{recommendedQuestions}}" 
          wx:for-item="question"
          wx:key="*this" 
          bindtap="onRecommendedQuestion" 
          data-question="{{question}}">
          {{question}}
        </view>
      </view>
    </view>
  </scroll-view>
  
  <!-- 悬浮清除按钮 -->
  <view class="floating-clear-btn" catchtap="clearChat" wx:if="{{messages.length > 0}}">
    <image class="clear-icon" src="/images/icons/clear.png" mode="aspectFit"></image>
  </view>
  
  <view class="input-area">
    <view class="input-container">
      <input 
        class="message-input" 
        value="{{inputValue}}" 
        bindinput="onInputChange"
        placeholder="请输入您的问题..." 
        confirm-type="send"
        bindconfirm="sendMessage"
        adjust-position="true"
        cursor-spacing="20"
      />
      <view class="erase-btn" bindtap="clearInput" wx:if="{{inputValue.length > 0 && !isLoading}}">
        <image class="erase-icon" src="/images/icons/erase.png"></image>
      </view>
      <view class="send-btn" bindtap="{{isLoading ? 'stopGenerating' : 'sendMessage'}}">
        <image class="send-icon" src="{{isLoading ? '/images/icons/send_stop.png' : '/images/send.png'}}"></image>
      </view>
    </view>
  </view>
</view> 