<!--pages/chat/chat.wxml-->
<view class="container chat-container">
  <!-- 隐藏的canvas用于生成分享图片 -->
  <canvas type="2d" id="shareCanvas" style="position: absolute; left: -9999px; width: 750px; height: {{canvasHeight}}px;"></canvas>

  <scroll-view scroll-y="true" class="message-list" scroll-top="{{scrollTop}}" id="message-container" enhanced="true" show-scrollbar="false" scroll-anchoring="true" bounces="{{false}}" enable-flex="true">

    <view class="message-list-content">
      <!-- 当没有消息时，显示欢迎页面 -->
      <view class="welcome-container" wx:if="{{messages.length === 0}}">
        <image class="app-logo" src="/images/smart_pregnancy.png" mode="aspectFit"></image>
        <view class="welcome-text">您好，我是智孕AI助手</view>
        <view class="welcome-subtext">有任何孕期相关问题，请随时向我咨询</view>

        <!-- 推荐问题区域 -->
        <view class="recommended-questions">
          <view class="recommended-question" wx:for="{{recommendedQuestions}}" wx:for-item="question" wx:key="*this" bindtap="onRecommendedQuestion" data-question="{{question}}">
            {{question}}
          </view>
        </view>
      </view>

      <block wx:for="{{messages}}" wx:key="id">
        <!-- 用户消息始终显示 -->
        <view class="message-item user-message" wx:if="{{item.type === 'user'}}" bindlongpress="onMessageLongPress" data-id="{{item.id}}" data-type="{{item.type}}">
          <view class="message-content user-content">
            <text class="message-text">{{item.content}}</text>
          </view>
        </view>

        <!-- 系统消息（AI回复）只有当有内容时才显示 -->
        <view class="message-item system-message" wx:if="{{item.type === 'system'}}" bindlongpress="onMessageLongPress" data-id="{{item.id}}" data-type="{{item.type}}">
          <view class="message-content system-content">
            <rich-text class="message-text" user-select="true" nodes="{{item.formattedContent || item.content}}"></rich-text>

            <!-- 只在AI回复消息中显示操作按钮，且不是正在加载的消息，且内容不为空 -->
            <view class="message-actions" wx:if="{{item.id !== loadingMessageId && item.content.length > 0}}">
              <view class="action-btn copy-btn" catchtap="copyMessage" data-content="{{item.content}}">
                <image class="action-icon" src="/images/icons/copy.png" mode="aspectFit"></image>
              </view>
              <view class="action-btn share-btn" catchtap="shareMessage" data-content="{{item.content}}" data-index="{{index}}" data-id="{{item.id}}">
                <image class="action-icon" src="/images/icons/share.png" mode="aspectFit"></image>
              </view>
              <view class="action-btn note-btn" catchtap="addNote" data-content="{{item.content}}" data-id="{{item.id}}">
                <image class="action-icon" src="/images/icons/note.png" mode="aspectFit"></image>
              </view>
              <view class="action-btn save-image-btn" catchtap="saveToImage" data-index="{{index}}">
                <image class="action-icon" src="/images/icons/save_image.png" mode="aspectFit"></image>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 加载中提示 -->
      <view class="loading-container" wx:if="{{isLoading}}">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>

      <!-- 推荐问题区域，只要有消息且不在加载中就显示 -->
      <view class="recommended-questions bottom-questions" wx:if="{{messages.length > 0 && !isLoading}}">
        <view class="recommended-question" wx:for="{{recommendedQuestions}}" wx:for-item="question" wx:key="*this" bindtap="onRecommendedQuestion" data-question="{{question}}">
          {{question}}
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 悬浮清除按钮 -->
  <view class="floating-clear-btn" catchtap="clearChat" wx:if="{{messages.length > 0}}">
    <image class="clear-icon" src="/images/icons/clear.png" mode="aspectFit"></image>
  </view>

  <!-- 长按消息操作菜单 -->
  <view class="message-action-menu" wx:if="{{showMessageActionMenu && !isLoading}}" catchtap="hideMessageActionMenu">
    <view class="menu-overlay"></view>
    <view class="menu-content" catchtap="stopPropagation" style="top: {{menuPosition}}px;">
      <view class="menu-options">
        <view class="menu-option" bindtap="copyFullText">
          <image class="menu-icon" src="/images/icons/copy_menu.png" mode="aspectFit"></image>
          <text class="menu-text">复制</text>
        </view>
        <view class="menu-option" bindtap="shareSelectedMessage">
          <image class="menu-icon" src="/images/icons/share_menu.png" mode="aspectFit"></image>
          <text class="menu-text">分享</text>
        </view>
        <view class="menu-option" bindtap="saveMessageImage">
          <image class="menu-icon" src="/images/icons/save_image_menu.png" mode="aspectFit"></image>
          <text class="menu-text">保存图片</text>
        </view>
        <view class="menu-option" bindtap="addNoteForSelectedMessage">
          <image class="menu-icon" src="/images/icons/note_menu.png" mode="aspectFit"></image>
          <text class="menu-text">添加笔记</text>
        </view>
        <view class="menu-option" bindtap="deleteSelectedMessage">
          <image class="menu-icon" src="/images/icons/delete.png" mode="aspectFit"></image>
          <text class="menu-text">删除</text>
        </view>
      </view>
      <view class="menu-arrow"></view>
    </view>
  </view>

  <view class="input-area">
    <view class="input-container">
      <input class="message-input" value="{{inputValue}}" bindinput="onInputChange" placeholder="请输入您的问题..." confirm-type="send" bindconfirm="sendMessage" adjust-position="true" cursor-spacing="20" />
      <view class="erase-btn" bindtap="clearInput" wx:if="{{inputValue.length > 0 && !isLoading}}">
        <image class="erase-icon" src="/images/icons/erase.png"></image>
      </view>
      <view class="send-btn" bindtap="{{isLoading ? 'stopGenerating' : 'sendMessage'}}">
        <image class="send-icon" src="{{isLoading ? '/images/icons/send_stop.png' : '/images/icons/send.png'}}"></image>
      </view>
    </view>
  </view>
</view>