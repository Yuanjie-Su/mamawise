/* pages/profile/profile.wxss */
.profile-container {
  background-color: #F8F8F8;
  min-height: 100vh;
}

.user-card {
  background-color: var(--primary-light);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  background-color: #FFFFFF;
}

.user-details {
  margin-left: 30rpx;
}

.username {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.user-desc {
  font-size: 26rpx;
  color: var(--text-light);
}

.login-btn {
  background-color: var(--primary-color);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin: 0;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.info-btn {
  background-color: var(--secondary-color);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin: 0;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.edit-btn {
  background-color: var(--primary-color);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin: 0;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.logout-btn {
  background-color: #f5f5f5;
  color: var(--text-light);
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin: 0;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.action-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 10rpx;
}

.menu-list {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-container {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
}

.arrow {
  color: var(--text-light);
  font-size: 30rpx;
}

.about-section {
  background-color: #FFFFFF;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.version-info {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 30rpx;
}

/* 日历卡片样式 */
.calendar-card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.calendar-content {
  display: flex;
  flex-direction: column;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.calendar-date {
  display: flex;
  align-items: center;
  width: 100%;
}

.calendar-day {
  font-size: 60rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-right: 20rpx;
  min-width: 80rpx;
  text-align: center;
}

.calendar-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.calendar-year-month {
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 6rpx;
}

.calendar-weekday-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.calendar-weekday {
  font-size: 24rpx;
  color: var(--text-light);
  margin-right: 10rpx;
}

.solar-term-info {
  display: inline-flex;
  align-items: center;
  background-color: rgba(var(--primary-color-rgb), 0.1);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.solar-term-value {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 500;
}
