<!-- 笔记详情页面 -->
<view class="detail-container">
  <view class="content-container" wx:if="{{note}}">
    <!-- 加载中状态 -->
    <view class="loading-container" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 文档内容 - 可直接编辑的查看模式 -->
    <view class="content-card" wx:else>
      <!-- 标题 - 可直接编辑 -->
      <input class="document-title-input" value="{{editData.title}}" bindinput="onTitleInput" placeholder="请输入标题" />

      <!-- 内容 - 可直接编辑，占满底部区域 -->
      <view class="textarea-container">
        <textarea class="content-textarea" value="{{editData.content}}" bindinput="onContentInput" placeholder="请输入内容" maxlength="-1" auto-height="{{false}}" />
      </view>

      <!-- 保存状态提示 -->
      <view class="save-status {{saveStatus ? 'show' : ''}}">
        <text>{{saveStatusText}}</text>
      </view>
    </view>
  </view>

  <view class="not-found" wx:else>
    <text class="not-found-text">未找到该笔记内容</text>
    <button class="back-to-list" bindtap="backToList">返回笔记列表</button>
  </view>

  <!-- 悬浮保存按钮 -->
  <view class="floating-save-btn" bindtap="saveContent" wx:if="{{hasChanges}}">
    <image class="save-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
  </view>
</view>