<!--pages/records/records.wxml-->
<view class="container records-container">
  <!-- 未登录或未完善个人信息时的提示 -->
  <view class="auth-tip-container" wx:if="{{!isLoggedIn}}">
    <view class="auth-tip">
      <image class="auth-tip-icon" src="/images/profile.png"></image>
      <view class="auth-tip-text">
        <text wx:if="{{!isLoggedIn}}">请先登录后查看健康档案</text>
      </view>
      <button class="auth-tip-btn" bindtap="navigateToProfile">去登录</button>
    </view>
  </view>
  
  <!-- 已登录且已完善个人信息时显示内容 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 标签页导航 -->
    <view class="tabs">
      <view 
        wx:for="{{tabs}}" 
        wx:key="index" 
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        bindtap="switchTab"
        data-index="{{index}}">
        {{item}}
      </view>
    </view>
    
    <!-- 标签页内容 -->
    <view class="tab-content">
      <!-- 基本信息 -->
      <view class="tab-pane" hidden="{{activeTab !== 0}}">
        <view class="info-card">
          <view class="card-title">
            <text>孕期信息</text>
            <view class="add-info-btn" bindtap="showEditPregnancyInfoForm">
              <image class="edit-icon" src="/images/icons/edit.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="info-item">
            <text class="info-label">当前孕周</text>
            <text class="info-value">{{pregnancyInfo.week}}周</text>
          </view>
          <view class="info-item">
            <text class="info-label">预产期</text>
            <text class="info-value">{{pregnancyInfo.dueDate}}</text>
          </view>
          <view class="info-item" wx:if="{{pregnancyInfo.lastCheckup}}">
            <text class="info-label">末次产检</text>
            <text class="info-value">{{pregnancyInfo.lastCheckup}}</text>
          </view>
          <view class="baby-countdown" wx:if="{{pregnancyInfo.daysRemaining !== undefined && pregnancyInfo.daysRemaining !== ''}}">
            <image class="baby-icon" src="/images/icons/baby.png" mode="aspectFit"></image>
            <view class="countdown-text">
              <text wx:if="{{pregnancyInfo.daysRemaining > 0}}">距离宝宝出生还有</text>
              <text wx:else>宝宝即将出生</text>
              <text class="countdown-days" wx:if="{{pregnancyInfo.daysRemaining > 0}}">{{pregnancyInfo.daysRemaining}}</text>
              <text class="countdown-unit" wx:if="{{pregnancyInfo.daysRemaining > 0}}">天</text>
            </view>
          </view>
        </view>
        
        <view class="info-card">
          <view class="card-title">
            <text>其他信息</text>
            <view class="add-info-btn" bindtap="showEditOtherInfoForm">
              <image class="edit-icon" src="/images/icons/edit.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="info-item">
            <text class="info-label">年龄</text>
            <text class="info-value">{{otherInfo.age ? otherInfo.age + ' 岁' : '未设置'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">身高</text>
            <text class="info-value">{{otherInfo.height ? otherInfo.height + ' cm' : '未设置'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">体重</text>
            <text class="info-value">{{otherInfo.weight ? otherInfo.weight + ' kg' : '未设置'}}</text>
          </view>
        </view>
        
        <view class="info-card">
          <view class="card-title">
            <text>过敏信息</text>
            <view class="add-info-btn" bindtap="showAddAllergyForm">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="allergy-list" wx:if="{{allergyInfo && allergyInfo.length > 0}}">
            <view class="allergy-item" wx:for="{{allergyInfo}}" wx:key="index">
              {{item}}
              <view class="allergy-delete-btn" catchtap="deleteAllergy" data-index="{{index}}">
                <image class="delete-icon" src="/images/icons/delete.png" mode="aspectFit"></image>
              </view>
            </view>
          </view>
          <view class="empty-tip" wx:else>
            暂无过敏信息
          </view>
        </view>
        
        <view class="info-card">
          <view class="card-title">
            <text>饮食偏好</text>
            <view class="add-info-btn" bindtap="showAddDietPreferenceForm">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="allergy-list" wx:if="{{dietPreference && dietPreference.length > 0}}">
            <view class="allergy-item" wx:for="{{dietPreference}}" wx:key="index">
              {{item}}
              <view class="allergy-delete-btn" catchtap="deleteDietPreference" data-index="{{index}}">
                <image class="delete-icon" src="/images/icons/delete.png" mode="aspectFit"></image>
              </view>
            </view>
          </view>
          <view class="empty-tip" wx:else>
            暂无饮食偏好
          </view>
        </view>
      </view>
      
      <!-- 体征记录 -->
      <view class="tab-pane" hidden="{{activeTab !== 1}}">
        <!-- 血压记录 -->
        <view class="vitals-section">
          <view class="section-header">
            <text>血压记录</text>
            <view class="add-info-btn" bindtap="showAddVitalsForm" data-type="bloodPressure">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="vitals-list">
            <view class="vitals-item" wx:for="{{bloodPressureRecords}}" wx:key="date" bindtap="viewDetail" data-type="血压" data-index="{{index}}">
              <view class="vitals-date">{{item.date}} {{item.time}}</view>
              <view class="vitals-value">{{item.value}} mmHg</view>
              <view class="arrow">></view>
            </view>
            <view class="empty-tip" wx:if="{{!bloodPressureRecords || bloodPressureRecords.length === 0}}">
              暂无血压记录
            </view>
          </view>
        </view>
        
        <!-- 体重记录 -->
        <view class="vitals-section">
          <view class="section-header">
            <text>体重记录</text>
            <view class="add-info-btn" bindtap="showAddVitalsForm" data-type="weight">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="vitals-list">
            <view class="vitals-item" wx:for="{{weightRecords}}" wx:key="date" bindtap="viewDetail" data-type="体重" data-index="{{index}}">
              <view class="vitals-date">{{item.date}} {{item.time}}</view>
              <view class="vitals-value">{{item.value}} kg</view>
              <view class="arrow">></view>
            </view>
            <view class="empty-tip" wx:if="{{!weightRecords || weightRecords.length === 0}}">
              暂无体重记录
            </view>
          </view>
        </view>
        
        <!-- 血糖记录 -->
        <view class="vitals-section">
          <view class="section-header">
            <text>血糖记录</text>
            <view class="add-info-btn" bindtap="showAddVitalsForm" data-type="bloodSugar">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="vitals-list">
            <view class="vitals-item" wx:for="{{bloodSugarRecords}}" wx:key="date" bindtap="viewDetail" data-type="血糖" data-index="{{index}}">
              <view class="vitals-date">{{item.date}} {{item.time}}</view>
              <view class="vitals-value">{{item.value}} mmol/L</view>
              <view class="arrow">></view>
            </view>
            <view class="empty-tip" wx:if="{{!bloodSugarRecords || bloodSugarRecords.length === 0}}">
              暂无血糖记录
            </view>
          </view>
        </view>
        
        <!-- 体温记录 -->
        <view class="vitals-section">
          <view class="section-header">
            <text>体温记录</text>
            <view class="add-info-btn" bindtap="showAddVitalsForm" data-type="temperature">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="vitals-list">
            <view class="vitals-item" wx:for="{{temperatureRecords}}" wx:key="date" bindtap="viewDetail" data-type="体温" data-index="{{index}}">
              <view class="vitals-date">{{item.date}} {{item.time}}</view>
              <view class="vitals-value">{{item.value}} °C</view>
              <view class="arrow">></view>
            </view>
            <view class="empty-tip" wx:if="{{!temperatureRecords || temperatureRecords.length === 0}}">
              暂无体温记录
            </view>
          </view>
        </view>
        
        <!-- 心率记录 -->
        <view class="vitals-section">
          <view class="section-header">
            <text>心率记录</text>
            <view class="add-info-btn" bindtap="showAddVitalsForm" data-type="heartRate">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="vitals-list">
            <view class="vitals-item" wx:for="{{heartRateRecords}}" wx:key="date" bindtap="viewDetail" data-type="心率" data-index="{{index}}">
              <view class="vitals-date">{{item.date}} {{item.time}}</view>
              <view class="vitals-value">{{item.value}} 次/分</view>
              <view class="arrow">></view>
            </view>
            <view class="empty-tip" wx:if="{{!heartRateRecords || heartRateRecords.length === 0}}">
              暂无心率记录
            </view>
          </view>
        </view>
        
        <!-- 胎动记录 -->
        <view class="vitals-section">
          <view class="section-header">
            <text>胎动记录</text>
            <view class="add-info-btn" bindtap="showAddVitalsForm" data-type="fetalMovement">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="vitals-list">
            <view class="vitals-item" wx:for="{{fetalMovementRecords}}" wx:key="date" bindtap="viewDetail" data-type="胎动" data-index="{{index}}">
              <view class="vitals-date">{{item.date}} {{item.time}}</view>
              <view class="vitals-value">{{item.value}} 次/小时</view>
              <view class="arrow">></view>
            </view>
            <view class="empty-tip" wx:if="{{!fetalMovementRecords || fetalMovementRecords.length === 0}}">
              暂无胎动记录
            </view>
          </view>
        </view>
      </view>
      
      <!-- 用药记录 -->
      <view class="tab-pane" hidden="{{activeTab !== 2}}">
        <view class="medication-section">
          <view class="section-header">
            <text>用药记录</text>
            <view class="add-info-btn" bindtap="showAddMedicationForm">
              <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="medication-list">
            <view class="medication-item" wx:for="{{medications}}" wx:key="index" bindtap="showEditMedicationForm" data-index="{{index}}">
              <view class="medication-info">
                <view class="medication-name">
                  {{item.name}}
                  <text class="medication-type" wx:if="{{item.type}}">{{item.type}}</text>
                </view>
                <view class="medication-details">
                  <text class="medication-dosage">{{item.dosage}}</text>
                  <text class="medication-frequency">{{item.frequency}}</text>
                  <text class="medication-time" wx:if="{{item.time}}">{{item.time}}</text>
                </view>
                <view class="medication-dates" wx:if="{{item.startDate}}">
                  <text>{{item.startDate}} 至 {{item.endDate || '长期'}}</text>
                </view>
              </view>
              <view class="medication-actions">
                <view class="edit-btn" catchtap="showEditMedicationForm" data-index="{{index}}">编辑</view>
                <view class="delete-btn" catchtap="deleteMedication" data-index="{{index}}">删除</view>
              </view>
            </view>
            
            <!-- 没有记录时显示提示 -->
            <view class="empty-tip" wx:if="{{!medications || medications.length === 0}}">
              暂无用药记录
            </view>
          </view>
        </view>
      </view>
      
      <!-- 产检记录 -->
      <view class="tab-pane" hidden="{{activeTab !== 3}}">
        <view class="section-header">
          <text>产检记录</text>
          <view class="add-info-btn" bindtap="uploadCheckupRecord">
            <image class="edit-icon" src="/images/icons/add.png" mode="aspectFit"></image>
          </view>
        </view>
        
        <!-- 历史产检记录分析结果 -->
        <view class="info-card" wx:if="{{checkupAnalysis}}">
          <view class="card-title">产检记录分析</view>
          <view class="analysis-content">{{checkupAnalysis}}</view>
        </view>
        
        <view class="checkup-list">
          <view class="checkup-item" wx:for="{{checkupRecords}}" wx:key="date">
            <view class="checkup-header">
              <view class="checkup-date">{{item.date}}</view>
              <view class="checkup-week">孕{{item.week}}周</view>
            </view>
            <view class="checkup-body">
              <view class="checkup-hospital">{{item.hospital}}</view>
              <view class="checkup-doctor">医生: {{item.doctor}}</view>
              <view class="checkup-items">
                <view class="checkup-item-row" wx:for="{{item.items}}" wx:for-item="checkItem" wx:key="name">
                  <text class="item-name">{{checkItem.name}}:</text>
                  <text class="item-value">{{checkItem.value}}</text>
                </view>
              </view>
              <view class="checkup-notes">
                <text class="notes-label">医嘱:</text>
                <text class="notes-content">{{item.notes}}</text>
              </view>
            </view>
          </view>
          
          <!-- 没有记录时显示提示 -->
          <view class="empty-tip" wx:if="{{!checkupRecords || checkupRecords.length === 0}}">
            暂无产检记录
          </view>
        </view>
      </view>
    </view>
  </block>
  
  <!-- 用药表单弹窗 -->
  <view class="medication-form" wx:if="{{showMedicationForm}}">
    <view class="form-overlay" bindtap="hideMedicationForm"></view>
    <view class="form-container">
      <view class="form-header">
        <text class="form-title">{{editingMedication ? '编辑用药' : '添加用药'}}</text>
        <view class="close-btn" bindtap="hideMedicationForm">×</view>
      </view>
      <view class="form-content">
        <view class="form-item">
          <text class="form-label">药物名称 *</text>
          <input class="form-input" placeholder="请输入药物名称" value="{{medicationForm.name}}" bindinput="onMedicationInputChange" data-field="name" />
        </view>
        
        <view class="form-item">
          <text class="form-label">药物类型</text>
          <picker bindchange="onMedicationTypeChange" value="{{medicationForm.typeIndex}}" range="{{medicationTypes}}">
            <view class="picker-view">
              <text>{{medicationTypes[medicationForm.typeIndex] || '请选择药物类型'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">剂量 *</text>
          <input class="form-input" placeholder="请输入剂量，如：5mg、1片" value="{{medicationForm.dosage}}" bindinput="onMedicationInputChange" data-field="dosage" />
        </view>
        
        <view class="form-item">
          <text class="form-label">服用频率 *</text>
          <input class="form-input" placeholder="请输入频率，如：每日一次、每8小时一次" value="{{medicationForm.frequency}}" bindinput="onMedicationInputChange" data-field="frequency" />
        </view>
        
        <view class="form-item">
          <text class="form-label">服用时间</text>
          <picker bindchange="onMedicationTimeChange" value="{{medicationForm.timeIndex}}" range="{{medicationTimes}}">
            <view class="picker-view">
              <text>{{medicationTimes[medicationForm.timeIndex] || '请选择服用时间'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">开始日期</text>
          <picker mode="date" bindchange="onStartDateChange" value="{{medicationForm.startDate}}">
            <view class="picker-view">
              <text>{{medicationForm.startDate || '请选择开始日期'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">结束日期</text>
          <picker mode="date" bindchange="onEndDateChange" value="{{medicationForm.endDate}}">
            <view class="picker-view">
              <text>{{medicationForm.endDate || '请选择结束日期（可选）'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">备注</text>
          <textarea class="form-textarea" placeholder="请输入备注信息（可选）" value="{{medicationForm.notes}}" bindinput="onMedicationInputChange" data-field="notes" />
        </view>
      </view>
      <view class="form-footer allergy-form-footer">
        <view class="icon-btn cancel-icon-btn" bindtap="hideMedicationForm">
          <image class="btn-icon" src="/images/icons/cancel.png" mode="aspectFit"></image>
        </view>
        <view class="icon-btn save-icon-btn" bindtap="saveMedication">
          <image class="btn-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 体征记录表单弹窗 -->
  <view class="vitals-form" wx:if="{{showVitalsForm}}">
    <view class="form-overlay" bindtap="hideVitalsForm"></view>
    <view class="form-container">
      <view class="form-header">
        <text class="form-title">{{editingVitals ? '编辑' + currentVitalsTypeName + '记录' : '添加' + currentVitalsTypeName + '记录'}}</text>
        <view class="close-btn" bindtap="hideVitalsForm">×</view>
      </view>
      <view class="form-content">
        <view class="form-item">
          <text class="form-label">体征类型</text>
          <view class="vitals-type-display">
            {{vitalsTypes[vitalsTypeIndex].name}}
            <text class="vitals-unit">({{vitalsTypes[vitalsTypeIndex].unit}})</text>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">数值 *</text>
          <picker bindchange="onVitalsValueChange" value="{{vitalsValueIndex}}" range="{{vitalsTypes[vitalsTypeIndex].valueOptions}}">
            <view class="picker-view">
              <text>{{vitalsTypes[vitalsTypeIndex].valueOptions[vitalsValueIndex] || '请选择数值'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <view class="value-range-tip">
            <text wx:if="{{vitalsTypeIndex === 0}}">正常范围：90/60 - 140/90 mmHg</text>
            <text wx:elif="{{vitalsTypeIndex === 1}}">孕期体重因人而异，请根据医嘱记录</text>
            <text wx:elif="{{vitalsTypeIndex === 2}}">正常范围：3.9 - 6.1 mmol/L</text>
            <text wx:elif="{{vitalsTypeIndex === 3}}">正常范围：36.3 - 37.3 °C</text>
            <text wx:elif="{{vitalsTypeIndex === 4}}">正常范围：60 - 100 次/分</text>
            <text wx:elif="{{vitalsTypeIndex === 5}}">正常范围：3 - 15 次/小时</text>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">日期 *</text>
          <picker mode="date" bindchange="onVitalsDateChange" value="{{vitalsForm.date}}">
            <view class="picker-view">
              <text>{{vitalsForm.date || '请选择日期'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">时间</text>
          <picker mode="time" bindchange="onVitalsTimeChange" value="{{vitalsForm.time}}">
            <view class="picker-view">
              <text>{{vitalsForm.time || '请选择时间'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">备注</text>
          <textarea class="form-textarea" placeholder="请输入备注信息（可选）" value="{{vitalsForm.notes}}" bindinput="onVitalsInputChange" data-field="notes" />
        </view>
      </view>
      <view class="form-footer allergy-form-footer">
        <view class="icon-btn cancel-icon-btn" bindtap="hideVitalsForm">
          <image class="btn-icon" src="/images/icons/cancel.png" mode="aspectFit"></image>
        </view>
        <view class="icon-btn save-icon-btn" bindtap="saveVitals">
          <image class="btn-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 过敏信息表单弹窗 -->
  <view class="info-form" wx:if="{{showAllergyForm}}">
    <view class="form-overlay" bindtap="hideAllergyForm"></view>
    <view class="form-container allergy-form-container">
      <view class="form-header allergy-form-header">
        <text class="form-title">添加过敏信息</text>
        <view class="close-btn" bindtap="hideAllergyForm">×</view>
      </view>
      <view class="form-content allergy-form-content">
          <input class="form-input" placeholder="请输入过敏信息，如：海鲜、花粉等" value="{{allergyForm.allergy}}" bindinput="onAllergyInputChange" />
          
          <view class="quick-select-title">示例</view>
          <view class="quick-select-list">
            <view 
              class="quick-select-item" 
              wx:for="{{allergyExamples}}" 
              wx:key="index" 
              bindtap="quickAddAllergy" 
              data-value="{{item}}">
              {{item}}
            </view>
          </view>
      </view>
      <view class="form-footer allergy-form-footer">
        <view class="icon-btn cancel-icon-btn" bindtap="hideAllergyForm">
          <image class="btn-icon" src="/images/icons/cancel.png" mode="aspectFit"></image>
        </view>
        <view class="icon-btn save-icon-btn" bindtap="saveAllergy">
          <image class="btn-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 饮食偏好表单弹窗 -->
  <view class="info-form" wx:if="{{showDietPreferenceForm}}">
    <view class="form-overlay" bindtap="hideDietPreferenceForm"></view>
    <view class="form-container allergy-form-container">
      <view class="form-header allergy-form-header">
        <text class="form-title">添加饮食偏好</text>
        <view class="close-btn" bindtap="hideDietPreferenceForm">×</view>
      </view>
      <view class="form-content allergy-form-content">
          <input class="form-input" placeholder="请输入饮食偏好，如：素食、低糖等" value="{{dietPreferenceForm.preference}}" bindinput="onDietPreferenceInputChange" />
          
          <view class="quick-select-title">示例</view>
          <view class="quick-select-list">
            <view 
              class="quick-select-item" 
              wx:for="{{dietExamples}}" 
              wx:key="index" 
              bindtap="quickAddDietPreference" 
              data-value="{{item}}">
              {{item}}
            </view>
          </view>
      </view>
      <view class="form-footer allergy-form-footer">
        <view class="icon-btn cancel-icon-btn" bindtap="hideDietPreferenceForm">
          <image class="btn-icon" src="/images/icons/cancel.png" mode="aspectFit"></image>
        </view>
        <view class="icon-btn save-icon-btn" bindtap="saveDietPreference">
          <image class="btn-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 其他信息表单弹窗 -->
  <view class="info-form" wx:if="{{showOtherInfoForm}}">
    <view class="form-overlay" bindtap="hideOtherInfoForm"></view>
    <view class="form-container">
      <view class="form-header">
        <text class="form-title">编辑基本信息</text>
        <view class="close-btn" bindtap="hideOtherInfoForm">×</view>
      </view>
      <view class="form-content">
        <view class="form-item">
          <text class="form-label">年龄 (岁)</text>
          <picker bindchange="onAgeChange" value="{{ageIndex}}" range="{{ageOptions}}">
            <view class="picker-view">
              <text wx:if="{{ageIndex >= 0}}">{{ageOptions[ageIndex]}} 岁</text>
              <text wx:else>请选择年龄（可选）</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <view class="form-action">
            <text class="clear-btn" catchtap="clearAge" wx:if="{{otherInfoForm.age}}">清除</text>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">身高 (cm)</text>
          <picker bindchange="onHeightChange" value="{{heightIndex}}" range="{{heightOptions}}">
            <view class="picker-view">
              <text wx:if="{{heightIndex >= 0}}">{{heightOptions[heightIndex]}} cm</text>
              <text wx:else>请选择身高（可选）</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <view class="form-action">
            <text class="clear-btn" catchtap="clearHeight" wx:if="{{otherInfoForm.height}}">清除</text>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">体重 (kg)</text>
          <picker bindchange="onWeightChange" value="{{weightIndex}}" range="{{weightOptions}}">
            <view class="picker-view">
              <text wx:if="{{weightIndex >= 0}}">{{weightOptions[weightIndex]}} kg</text>
              <text wx:else>请选择体重（可选）</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <view class="form-action">
            <text class="clear-btn" catchtap="clearWeight" wx:if="{{otherInfoForm.weight}}">清除</text>
          </view>
        </view>
      </view>
      <view class="form-footer allergy-form-footer">
        <view class="icon-btn cancel-icon-btn" bindtap="hideOtherInfoForm">
          <image class="btn-icon" src="/images/icons/cancel.png" mode="aspectFit"></image>
        </view>
        <view class="icon-btn save-icon-btn" bindtap="saveOtherInfo">
          <image class="btn-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 孕期信息表单弹窗 -->
  <view class="info-form" wx:if="{{showPregnancyInfoForm}}">
    <view class="form-overlay" bindtap="hidePregnancyInfoForm"></view>
    <view class="form-container">
      <view class="form-header">
        <text class="form-title">编辑孕期信息</text>
        <view class="close-btn" bindtap="hidePregnancyInfoForm">×</view>
      </view>
      <view class="form-content">
        <view class="form-item">
          <text class="form-label">当前孕周</text>
          <picker bindchange="onPregnancyWeekChange" value="{{pregnancyWeekIndex}}" range="{{pregnancyWeekOptions}}">
            <view class="picker-view">
              <text>{{pregnancyWeekOptions[pregnancyWeekIndex] || '请选择孕周'}} 周</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">预产期</text>
          <picker mode="date" bindchange="onDueDateChange" value="{{pregnancyInfoForm.dueDate}}">
            <view class="picker-view">
              <text>{{pregnancyInfoForm.dueDate || '请选择预产期'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <view class="form-tip">选择孕周后会自动计算预产期，您也可以手动选择</view>
        </view>
      </view>
      <view class="form-footer allergy-form-footer">
        <view class="icon-btn cancel-icon-btn" bindtap="hidePregnancyInfoForm">
          <image class="btn-icon" src="/images/icons/cancel.png" mode="aspectFit"></image>
        </view>
        <view class="icon-btn save-icon-btn" bindtap="savePregnancyInfo">
          <image class="btn-icon" src="/images/icons/finished.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
</view>