  margin-left: 10rpx;
}

.edit-btn {
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

.delete-btn {
  color: #FF4D4F;
  border: 1rpx solid #FF4D4F;
}

/* 用药表单样式 */
.medication-form {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.form-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.form-container {
  position: relative;
  width: 90%;
  max-height: 90%;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.close-btn {
  font-size: 40rpx;
  color: var(--text-light);
  padding: 0 10rpx;
}

.form-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-view {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: var(--text-light);
  font-size: 24rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-footer {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
  border-top: none;
}

.cancel-btn, .submit-btn {
  display: none;
}

.done-btn {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.add-vitals-btn {
  display: none;
}

/* 体征记录表单样式 */
.vitals-form {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.vitals-type-display {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
}

.vitals-unit {
  color: var(--text-light);
  margin-left: 10rpx;
  font-size: 24rpx;
}

.value-range-tip {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 10rpx;
  padding: 0 10rpx;
}

.form-tip {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 10rpx;
  padding: 0 10rpx;
}

/* 宝宝出生倒计时样式 */
.baby-countdown {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: rgba(255, 192, 203, 0.1);
  border-radius: 12rpx;
  border: 1rpx dashed #FFC0CB;
}

.baby-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.countdown-text {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 28rpx;
  color: #FF6B81;
}

.countdown-days {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF4757;
  margin: 0 10rpx;
}

.countdown-unit {
  font-size: 28rpx;
  color: #FF6B81;
}

.edit-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

/* 过敏信息和饮食偏好表单样式 */
.info-form {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 产检记录按钮样式 */
.add-checkup-container {
  display: none;
}

.add-checkup-btn {
  display: none;
}

.add-checkup-icon {
  display: none;
}

/* 过敏信息编辑样式 */
.allergy-edit-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.allergy-edit-item {
  background-color: rgba(255, 192, 203, 0.2);
  color: var(--primary-color);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  position: relative;
  display: flex;
  align-items: center;
}

.allergy-delete-btn {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.delete-icon {
  width: 20rpx;
  height: 20rpx;
}

/* 过敏信息表单样式 */
.allergy-form-container {
  background-color: #FFFFFF;
  border-radius: 20rpx;
}

.allergy-form-header {
  border-bottom: none;
  padding-bottom: 10rpx;
}

.allergy-form-content {
  padding: 10rpx 30rpx 20rpx;
}

.allergy-form-footer {
  justify-content: flex-end;
  padding: 20rpx 30rpx;
}

/* 过敏信息表单图标按钮样式 */
.allergy-form-footer {
  justify-content: flex-end;
  padding: 20rpx 30rpx;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.cancel-icon-btn {
  background-color: #F5F5F5;
}

.save-icon-btn {
  background-color: #F5F5F5;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 按钮悬停效果 */
.icon-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 快速选择样式 */
.quick-select-title {
  font-size: 28rpx;
  color: var(--text-light);
  margin: 30rpx 0 15rpx;
}

.quick-select-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.quick-select-item {
  background-color: #F5F5F5;
  color: var(--text-color);
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  font-size: 24rpx;
  display: inline-block;
  border: 1rpx solid #E0E0E0;
}

.quick-select-item:active {
  background-color: rgba(255, 192, 203, 0.2);
  border-color: var(--primary-color);
  color: var(--primary-color);
}

.form-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
}

.clear-btn:active {
  background-color: #f0f0f0;
} 