/* pages/policy/policy.wxss */
.policy-container {
  background-color: #F8F8F8;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.policy-header {
  background-color: var(--primary-light);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.policy-content {
  padding: 0 30rpx;
}

.policy-section {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  color: var(--primary-color);
  margin-bottom: 20rpx;
  font-weight: bold;
}

.section-content {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
}

.content-item {
  margin-top: 20rpx;
  padding-left: 20rpx;
}

.policy-footer {
  text-align: center;
  color: var(--text-light);
  font-size: 24rpx;
  margin-top: 40rpx;
} 