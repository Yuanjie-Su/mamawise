<!-- 收藏页面 -->
<view class="favorites-container">
  <!-- 空状态提示 -->
  <view class="empty-state" wx:if="{{favorites.length === 0}}">
    <text class="empty-text">暂无收藏内容</text>
    <text class="empty-subtext">在聊天中点击"收藏"可将AI回复添加到收藏</text>
  </view>
  
  <!-- 收藏列表 -->
  <view class="favorites-list" wx:else>
    <view class="favorite-item" wx:for="{{favorites}}" wx:key="id" bindtap="viewFavorite" data-id="{{item.id}}">
      <view class="favorite-title">{{item.title || '收藏内容'}}</view>
      <view class="favorite-content">
        <rich-text class="favorite-text" nodes="{{item.formattedContent || item.content}}"></rich-text>
      </view>
      <view class="favorite-footer">
        <text class="favorite-date">{{item.date}}</text>
        <view class="favorite-actions">
          <view class="action-btn" catchtap="deleteFavorite" data-id="{{item.id}}">
            <image class="action-icon" src="/images/icons/cancel.png"></image>
            <text>删除</text>
          </view>
          <view class="action-btn" catchtap="shareFavorite" data-id="{{item.id}}">
            <image class="action-icon" src="/images/icons/share.png"></image>
            <text>分享</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 用于生成分享图片的画布（隐藏） -->
  <canvas canvas-id="shareCanvas" style="width: 300px; height: 400px; position: fixed; top: -1000px;"></canvas>
</view> 