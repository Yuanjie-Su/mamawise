.detail-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f8f8f8;
}

.content-container {
  padding: 30rpx;
  flex: 1;
}

/* 加载中状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #E57B9E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.content-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.document-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  line-height: 1.4;
  text-align: center;
}

.content-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 30rpx;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.content-date {
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: normal;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.action-button.delete {
  background-color: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}

.action-button.share {
  background-color: #1890ff;
  color: #fff;
}

.action-button.image {
  background-color: #52c41a;
  color: #fff;
}

.button-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 50rpx;
  margin-top: 100rpx;
}

.not-found-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.not-found-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

.back-to-list {
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
} 